# Neon: la agrupada (con -pooler) para la app, la directa para las migraciones.
DATABASE_URL="postgresql://USUARIO:CLAVE@HOST-pooler.REGION.aws.neon.tech/apolodrinks?sslmode=require"
DIRECT_URL="postgresql://USUARIO:CLAVE@HOST.REGION.aws.neon.tech/apolodrinks?sslmode=require"

# Credenciales de acceso (generadas con: npm run credenciales)
AUTH_USUARIO=""
AUTH_PASSWORD_HASH=""
AUTH_SECRET=""

# Opcional: freno de fuerza bruta compartido. Sin esto el conteo es por instancia,
# que en Vercel no sirve. Se sacan del panel de Upstash.
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""
